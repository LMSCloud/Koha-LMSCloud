[% USE raw %]
[% PROCESS 'i18n.inc' %]
[% INCLUDE 'doc-head-open.inc' %]
<title
    >[% FILTER collapse %]
        [% tx("Print notices for {today}", { today = today }) | html %]
    [% END %]</title
>

<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<!-- prettier-ignore-start -->
    <style>
        <!--
        .print-notice, .message { page-break-after: always }
        pre { font-family: monospace }
        pre {white-space: pre-wrap;}
        -->
    </style>
    <!-- prettier-ignore-end -->
[% IF ( stylesheet ) %]
    <link rel="stylesheet" type="text/css" href="[% stylesheet | url %]" />
[% END %]
</head>
<body id="batch_print-notices" class="batch">
[% FOREACH message IN messages %]
    [% IF ( message.is_html ) %]
        <div class="print-notice">
            [% message.content | $raw %]
        </div>
    [% ELSE %]
        <div class="message">
            <pre>[% message.content | $raw %]</pre>
        </div>
    [% END %]
[% END %]
</body>
<!-- prettier-ignore-start -->
</html>
<!-- prettier-ignore-end -->
