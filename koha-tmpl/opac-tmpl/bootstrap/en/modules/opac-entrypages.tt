[% USE Koha %]
[% USE raw %]
[% USE Asset %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% IF ( LibraryNameTitle ) %][% LibraryNameTitle | html %][% ELSE %]Koha[% END %] - Browse Catalog</title>
[% INCLUDE 'doc-head-close.inc' %]
[% BLOCK cssinclude %]
[% END %]
</head>
[% INCLUDE 'bodytag.inc' bodyid='advsearch' bodyclass='scrollto' %]
[% INCLUDE 'masthead.inc' %]

[% SET opacentrypagename = "$pagename" %]
[% IF ( lang ) %]
    [% SET testname = "${pagename}_$lang" %]
    [% IF ( Koha.Preference( "$testname" ) ) %]
        [% SET opacentrypagename = "$testname" %]
    [% END %]
[% END %]
[% Koha.Preference( opacentrypagename ) | eval | $raw %]

[% INCLUDE 'opac-bottom.inc' %]
[% BLOCK searchbuttons %]
[% END %]

[% BLOCK jsinclude %]
    [% Asset.js("lib/jquery/plugins/jquery.deserialize.min.js") | $raw %]
    <script type="text/javascript">
        //<![CDATA[
        function startSearch() {}
        //]]>
    </script>
[% END %]
